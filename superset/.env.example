# Copy to .env and replace the values below. To generate a random string run:
#   python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=replace-with-a-long-random-string

# Local admin account (scripts/build_superset_dashboards.py uses it to log in to the API)
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=replace-with-your-password
